[
  {
    "label": "Build and run: native (debug)",
    "command": "cargo run --locked --package yp_app --bin YoRHa-Protocol-Launcher",
    "cwd": "$ZED_WORKTREE_ROOT/yp_launcher_new",
    "env": { "YP_ASSETS_DIR": "$ZED_WORKTREE_ROOT/yp_launcher_new/assets", "RUST_BACKTRACE": "1" },
    "shell": { "program": "pwsh" }
  },
  {
    "label": "Build and run: native (debug symbols)",
    "command": "cargo run --locked --package yp_app --bin YoRHa-Protocol-Launcher --config profile.dev.debug=2",
    "cwd": "$ZED_WORKTREE_ROOT/yp_launcher_new",
    "env": { "YP_ASSETS_DIR": "$ZED_WORKTREE_ROOT/yp_launcher_new/assets", "RUST_BACKTRACE": "1" },
    "shell": { "program": "pwsh" }
  },
  {
    "label": "Build and run: native (small release)",
    "command": "cargo run --locked --package yp_app --bin YoRHa-Protocol-Launcher --profile small --features embedded-assets",
    "cwd": "$ZED_WORKTREE_ROOT/yp_launcher_new",
    "env": { "YP_ASSETS_DIR": "$ZED_WORKTREE_ROOT/yp_launcher_new/assets", "RUST_BACKTRACE": "1" },
    "shell": { "program": "pwsh" }
  },
  {
