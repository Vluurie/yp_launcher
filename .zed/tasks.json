    "env": { "YP_ASSETS_DIR": "$ZED_WORKTREE_ROOT/yp_launcher_new/assets", "RUST_BACKTRACE": "1" },
    "shell": { "program": "pwsh" }
  },
  {
    "label": "Build and run: macOS Apple Silicon",
    "command": "cargo run --locked --package yp_app --bin YoRHa-Protocol-Launcher --target aarch64-apple-darwin",
    "cwd": "$ZED_WORKTREE_ROOT/yp_launcher_new",
    "env": { "YP_ASSETS_DIR": "$ZED_WORKTREE_ROOT/yp_launcher_new/assets", "RUST_BACKTRACE": "1" },
