{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build and run: native (debug)",
            "type": "process",
            "command": "cargo",
            "args": [
                "run",
                "--locked",
                "--package",
                "yp_app",
                "--bin",
                "YoRHa-Protocol-Launcher"
            ],
            "options": {
                "cwd": "${workspaceFolder}/yp_launcher_new",
                "env": {
                    "YP_ASSETS_DIR": "${workspaceFolder}/yp_launcher_new/assets",
                    "RUST_BACKTRACE": "1"
                }
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "problemMatcher": {
                "base": "$rustc",
                "fileLocation": [
                    "relative",
                    "${workspaceFolder}/yp_launcher_new"
                ]
            },
            "detail": "Build and launch the launcher for this machine using its normal settings.",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Build and run: native (debug symbols)",
            "type": "process",
            "command": "cargo",
            "args": [
                "run",
                "--locked",
                "--package",
                "yp_app",
                "--bin",
                "YoRHa-Protocol-Launcher",
                "--config",
                "profile.dev.debug=2"
            ],
            "options": {
                "cwd": "${workspaceFolder}/yp_launcher_new",
                "env": {
                    "YP_ASSETS_DIR": "${workspaceFolder}/yp_launcher_new/assets",
                    "RUST_BACKTRACE": "1"
                }
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "problemMatcher": {
                "base": "$rustc",
                "fileLocation": [
                    "relative",
                    "${workspaceFolder}/yp_launcher_new"
                ]
            },
            "detail": "Build and launch with full Rust debug information.",
            "group": "build"
        },
